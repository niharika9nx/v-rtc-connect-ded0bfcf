# Copy this file to .env and fill in values from your Supabase project settings.
# These are safe to expose in the browser bundle (RLS protects data).
# NEVER commit the actual .env file or the SUPABASE_SERVICE_ROLE_KEY.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"